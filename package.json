{
  "name": "mentingo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "packages:build": "pnpm --filter @repo/shared build && pnpm --filter @repo/email-templates build && pnpm --filter @repo/prompts build && pnpm --filter @repo/scorm-export-runtime build && pnpm --filter @repo/scorm-export-generator build",
    "dev": "turbo dev",
    "dev:test": "turbo dev:test",
    "setup:unix": "chmod +x setup.sh && ./setup.sh",
    "setup:win": "bash setup.sh",
    "lint": "turbo lint",
    "lint-tsc-web": "pnpm run --filter=web lint-tsc",
    "lint-tsc-api": "pnpm run --filter=api lint-tsc",
    "format": "prettier --write \"**/*.{ts,tsx,md,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,js,jsx,json}\"",
    "generate:client": "pnpm run --filter=web generate:client",
    "db:generate": "pnpm run --filter=api db:generate",
    "db:migrate": "pnpm run --filter=api db:migrate",
    "db:seed": "pnpm run --filter=api db:seed",
    "test:web": "pnpm run --filter=web test",
    "test:api": "pnpm run --filter=api test",
    "test:web:e2e": "pnpm run --filter=web test:e2e",
    "test:api:e2e": "pnpm run --filter=api test:e2e",
    "perf:load": "pnpm --filter @mentingo/performance-tests test:load",
    "perf:stress": "pnpm --filter @mentingo/performance-tests test:stress",
    "perf:spike": "pnpm --filter @mentingo/performance-tests test:spike",
    "perf:soak": "pnpm --filter @mentingo/performance-tests test:soak",
    "perf:mixed": "pnpm --filter @mentingo/performance-tests test:mixed",
    "perf:load:dashboard": "pnpm --filter @mentingo/performance-tests test:load:dashboard",
    "start:debug": "pnpm run --filter=api start:debug",
    "prepare": "husky",
    "gpush": "git push --no-verify",
    "test:ai:regression": "pnpm --filter=api test:ai:regression",
    "eval:ai": "pnpm --filter=api eval:ai",
    "eval:ai:record": "python3 scripts/langfuse/record.py --setup docs/langfuse/remote-setup.json --manifest apps/api/test/evaluations/feature-catalogue.v1.json",
    "eval:ai:experiment": "python3 scripts/langfuse/experiment.py"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "prettier": "3.4.1",
    "prettier-plugin-tailwindcss": "0.6.9",
    "tsc-files": "1.1.4",
    "turbo": "2.3.3",
    "typescript": "5.4.5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.12",
      "undici@7.30.0": "7.30.1",
      "zod@>=4.0.0 <4.6.6": "4.6.6",
      "file-type@20.5.0": "21.3.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "path-to-regexp@>=3.0.0 <3.3.0": "3.3.0",
      "prismjs@>=1.0.0 <1.30.0": "1.30.0",
      "ws@>=8.0.0 <8.23.0": "8.23.0",
      "body-parser@>=1.0.0 <1.20.9": "1.20.9",
      "path-to-regexp@>=0.1.0 <0.1.13": "0.1.13",
      "qs@>=6.0.0 <6.17.1": "6.17.1",
      "prosemirror-view": "1.42.3",
      "uuid@>=11.0.0 <11.1.1": "11.1.1",
      "canvas": "-",
      "multer@>=2.0.0 <2.3.0": "2.3.0",
      "protobufjs@>=7.0.0 <7.6.1": "7.6.1",
      "@grpc/grpc-js@>=1.0.0 <1.14.5": "1.14.5",
      "lodash@<4.18.1": "4.18.1",
      "minimatch@>=9.0.0 <9.0.7": "9.0.9",
      "glob@>=10.0.0 <10.5.0": "10.5.0",
      "engine.io@>=6.0.0 <6.6.7": "6.6.12",
      "source-map-js@<1.2.2": "1.2.4",
      "tar-fs@>=3.0.0 <3.1.1": "3.1.4",
      "tmp@<0.2.7": "0.2.7",
      "browserslist@<4.28.7": "4.29.6",
      "postcss@>=8.0.0 <8.5.18": "8.5.33",
      "workflow>@workflow/next": "-"
    },
    "packageExtensions": {
      "@hookform/resolvers@3.9.0": {
        "dependencies": {
          "zod": "3.25.76"
        }
      }
    }
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.3"
  }
}
