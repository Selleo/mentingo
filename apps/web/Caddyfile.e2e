{
    admin :2020
    auto_https disable_redirects
    skip_install_trust
}

# Invitation and password-reset emails require HTTPS action links.
https://localhost:5173, https://*.lms.localhost:5173 {
    tls internal
    handle /api/* {
        reverse_proxy http://localhost:3000
    }

    handle {
        root * ./build/client
        try_files {path} /index.html
        file_server
    }
}

https://scorm.localhost:5443 {
    tls internal

    @content {
        path /api/scorm/delivery/*
        method GET HEAD
    }

    handle @content {
        reverse_proxy localhost:3000 {
            header_up -Cookie
            header_up -Authorization
            header_down -Set-Cookie
        }
    }

    handle {
        respond 404
    }
}
